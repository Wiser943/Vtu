          </div>
          <button class="va-copy" onclick="copyText('<%= user.virtualAccount.accountNumber %>')" title="Copy"><i class="ri-file-copy-line"></i></button>
        </div>
        <% } %>
      </div>
      <div class="stat-card">
        <div class="sc-top">
          <div class="sc-ic" style="background:var(--blue-dim);color:var(--blue)"><i class="ri-signal-wifi-line"></i></div>
          <span class="trend t-up"><i class="ri-arrow-up-line"></i> 12%</span>
        </div>
        <div class="sc-val" style="color:var(--blue)">₦<%= typeof monthlyTotal !== 'undefined' ? Math.floor(monthlyTotal*0.65).toLocaleString() : '0' %></div>
        <div class="sc-lbl">Data Volume — Month</div>
        <div class="sc-bar"><div class="sc-fill" style="width:65%;background:var(--blue)"></div></div>
      </div>
