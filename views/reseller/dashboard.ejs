      <div style="flex:1">
        <div class="sl-title"><%= promo.title %></div>
        <div class="sl-sub"><%= promo.message %></div>
      </div>
      <% if(promo.ctaText) { %><button class="sl-cta" onclick="location.href='<%= promo.ctaLink||'#' %>'"><%= promo.ctaText %></button><% } %>
      <button class="sl-close" onclick="document.getElementById('banner-<%= idx %>').remove()"><i class="ri-close-line"></i></button>
    </div>
    <% }) %>
    <% } %>

    <!-- WALLET + STATS -->
