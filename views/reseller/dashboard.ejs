      <div class="wc">
        <div class="wc-lbl">Reseller Wallet</div>
        <div class="wc-bal" id="wBal">₦<%= user.walletBalance.toLocaleString() %></div>
        <div class="wc-meta">
          <div><div class="wc-s-lbl">Today</div><div class="wc-s-val">₦<%= typeof dailyTotal !== 'undefined' ? Math.floor(dailyTotal).toLocaleString() : '0' %></div></div>
          <div><div class="wc-s-lbl">This Month</div><div class="wc-s-val">₦<%= typeof monthlyTotal !== 'undefined' ? Math.floor(monthlyTotal).toLocaleString() : '0' %></div></div>
          <div><div class="wc-s-lbl">Tx Count</div><div class="wc-s-val"><%= typeof monthlyCount !== 'undefined' ? monthlyCount : '0' %></div></div>
        </div>
        <div class="wc-btns">
          <button class="wc-btn wc-p" onclick="openMo('fundMo')"><i class="ri-add-circle-line"></i> Fund</button>
          <button class="wc-btn wc-g" onclick="location.href='/reseller/transactions'"><i class="ri-file-list-3-line"></i> Statement</button>
          <button class="wc-btn wc-g" onclick="location.href='/reseller/api-keys'"><i class="ri-code-s-slash-line"></i> API Keys</button>
        </div>
        <% if(user.virtualAccount?.accountNumber) { %>
        <div class="va">
          <div class="va-ic"><i class="ri-bank-line"></i></div>
          <div>
            <div class="va-lbl">Fund via — <%= user.virtualAccount.bankName %></div>
