<div class="tc" id="tc"></div>

<script>
const ham=document.getElementById('ham'),sb=document.getElementById('sidebar'),ov=document.getElementById('sidebarOverlay');
ham?.addEventListener('click',()=>{sb.classList.toggle('open');ov.classList.toggle('open')});
ov?.addEventListener('click',()=>{sb.classList.remove('open');ov.classList.remove('open')});
function openMo(id){document.getElementById(id).classList.add('open')}
function closeMo(id){document.getElementById(id).classList.remove('open')}
document.querySelectorAll('.mo').forEach(m=>m.addEventListener('click',function(e){if(e.target===this)this.classList.remove('open')}));
function toast(msg,type='info'){
  const c=document.getElementById('tc');
  const ic={success:'ri-checkbox-circle-line',error:'ri-close-circle-line',info:'ri-information-line'};
  const t=document.createElement('div');t.className=`toast ${type}`;
  t.innerHTML=`<i class="${ic[type]}" style="font-size:17px;color:var(--${type==='success'?'green':type==='error'?'red':'blue'})"></i><span class="toast-msg">${msg}</span><button class="toast-x" onclick="this.closest('.toast').remove()"><i class="ri-close-line"></i></button>`;
  document.getElementById('tc').appendChild(t);
  setTimeout(()=>t.remove(),4500);
}
function copyText(t){navigator.clipboard.writeText(t);toast('Copied!','success')}
function setAmt(id,v){document.getElementById(id).value=v}
document.querySelectorAll('.net-pills').forEach(c=>{c.querySelectorAll('.np').forEach(p=>{p.addEventListener('click',function(){c.querySelectorAll('.np').forEach(x=>x.classList.remove('active'));this.classList.add('active')})})});
document.querySelectorAll('.pin-i').forEach((inp,i,all)=>{
  inp.addEventListener('input',()=>{if(inp.value&&i<all.length-1)all[i+1].focus()});
  inp.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!inp.value&&i>0)all[i-1].focus()});
});
function getPin(container){return[...container.querySelectorAll('.pin-i')].map(i=>i.value).join('')}
function showPrice(){
  const sel=document.getElementById('dataPlan');const d=document.getElementById('priceDisplay');const v=document.getElementById('priceVal');
  if(sel.value){const p=sel.value.split('|');v.textContent='₦'+parseInt(p[3]).toLocaleString();d.style.display='flex'}else d.style.display='none';
}
async function initFund(){
  const amt=parseFloat(document.getElementById('fundAmt').value);
  if(!amt||amt<1000)return toast('Minimum fund is ₦1,000','error');
  const btn=document.getElementById('fundBtn');btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/reseller/wallet/fund',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount:amt})});
    const d=await r.json();
    if(d.success&&d.checkoutUrl)window.location.href=d.checkoutUrl;
    else toast(d.message||'Failed','error');
  }catch(e){toast('Server error','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-bank-card-line"></i> Pay with Card';
}
async function doAirtime(){
  const network=document.querySelector('#airNets .np.active')?.dataset.net;
  const phone=document.getElementById('airPhone').value.trim();
  const amount=parseFloat(document.getElementById('airAmt').value);
  const pin=getPin(document.querySelector('#airtimeMo .pin-row'));
  if(!network||!phone||phone.length!==11||!amount||pin.length!==4)return toast('Fill all fields correctly','error');
  const btn=document.getElementById('airBtn');btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/reseller/airtime',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({network,phone,amount,pin})});
    const d=await r.json();
    if(d.success){toast(d.message,'success');closeMo('airtimeMo');setTimeout(()=>location.reload(),2000)}
    else toast(d.message,'error');
  }catch(e){toast('Server error','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-phone-line"></i> Buy Airtime';
}
async function doData(){
  const network=document.querySelector('#dataNets .np.active')?.dataset.net;
  const phone=document.getElementById('dataPhone').value.trim();
  const planSel=document.getElementById('dataPlan').value;
  const pin=getPin(document.getElementById('dataPinRow'));
  if(!phone||phone.length!==11||!planSel||pin.length!==4)return toast('Fill all fields correctly','error');
  const parts=planSel.split('|');
  const [serviceId,variationCode,planName,amount]=parts;
  const btn=document.getElementById('dataBtn');btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/reseller/data',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({serviceId,variationCode,phone,pin,planName,amount})});
    const d=await r.json();
    if(d.success){toast(d.message,'success');closeMo('dataMo');setTimeout(()=>location.reload(),2000)}
    else toast(d.message,'error');
  }catch(e){toast('Server error','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-signal-wifi-line"></i> Buy Data';
}
async function generateApiKey(){
  const r=await fetch('/reseller/api-keys/generate',{method:'POST'});
  const d=await r.json();
  if(d.success){toast('API key generated!','success');setTimeout(()=>location.reload(),1500)}
  else toast(d.message,'error');
}
// PWA
let deferredPrompt;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault();deferredPrompt=e;
  if(!localStorage.getItem('pwaDismissed'))setTimeout(()=>document.getElementById('pwaBanner').classList.add('show'),4000);
});
document.getElementById('pwaInstallBtn')?.addEventListener('click',async()=>{
  if(!deferredPrompt)return;
  deferredPrompt.prompt();const{outcome}=await deferredPrompt.userChoice;
  if(outcome==='accepted')toast('App installed!','success');
  deferredPrompt=null;document.getElementById('pwaBanner').classList.remove('show');
});
function dismissPwa(){document.getElementById('pwaBanner').classList.remove('show');localStorage.setItem('pwaDismissed','1')}
if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));
// Flash
