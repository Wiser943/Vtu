<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reseller Dashboard — NairaFlow</title>
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<style>
:root{--bg:#090f18;--surface:#0e1825;--card:#131f30;--card2:#192840;--border:#1e3050;--border2:#263d60;--text:#ddeeff;--text2:#6a8fba;--text3:#2d4a68;--primary:#f5a623;--primary2:#fbbf24;--primary-dim:rgba(245,166,35,.1);--primary-glow:rgba(245,166,35,.2);--green:#22d3a5;--green-dim:rgba(34,211,165,.09);--red:#f05f6e;--red-dim:rgba(240,95,110,.09);--blue:#38b2f8;--blue-dim:rgba(56,178,248,.09);--purple:#9b5de5;--purple-dim:rgba(155,93,229,.09)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Outfit',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex}
.sidebar{width:240px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;height:100vh;overflow-y:auto;z-index:200;transition:transform .3s}
.sidebar::-webkit-scrollbar{width:0}
.sb-head{padding:20px 16px;border-bottom:1px solid var(--border)}
.sb-brand{display:flex;align-items:center;gap:9px}
.sb-mark{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--primary),#d97706);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sb-mark i{color:#fff;font-size:17px}
.sb-name{font-size:17px;font-weight:800;letter-spacing:-.5px}
.sb-name span{color:var(--primary2)}
.sb-user{margin-top:12px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:11px 12px;display:flex;align-items:center;gap:9px}
.sb-av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#d97706);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0}
.sb-username{font-size:13px;font-weight:600}
.sb-tier{font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;display:inline-block;margin-top:2px;background:var(--primary-dim);color:var(--primary2)}
.sb-nav{padding:12px 10px;flex:1}
.sb-lbl{font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text3);padding:0 6px;margin:12px 0 4px;display:block}
.sb-item{display:flex;align-items:center;gap:9px;padding:9px 8px;border-radius:9px;font-size:13px;color:var(--text2);cursor:pointer;transition:all .18s;margin-bottom:1px;text-decoration:none;position:relative}
.sb-item:hover{background:var(--card2);color:var(--text)}
.sb-item.active{background:var(--primary-dim);color:var(--primary2)}
.sb-item.active::after{content:'';position:absolute;right:-10px;top:50%;transform:translateY(-50%);width:3px;height:16px;background:var(--primary2);border-radius:4px 0 0 4px}
.sb-item i{font-size:15px;width:16px;text-align:center;flex-shrink:0}
.sb-badge{margin-left:auto;font-size:9px;font-weight:700;padding:2px 6px;border-radius:20px;background:var(--primary-dim);color:var(--primary2)}
.sb-bottom{padding:12px;border-top:1px solid var(--border)}
.sb-logout{display:flex;align-items:center;gap:9px;width:100%;padding:9px;border-radius:9px;background:none;border:1px solid var(--border);color:var(--text2);font-size:13px;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .18s}
.sb-logout:hover{background:var(--red-dim);border-color:var(--red);color:var(--red)}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:150}
.main-wrap{margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:100;background:rgba(9,15,24,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0 24px;height:60px;display:flex;align-items:center;gap:12px}
.hamburger{display:none;background:none;border:none;color:var(--text2);font-size:22px;cursor:pointer}
.tb-title{font-size:16px;font-weight:700;flex:1}
.tb-icon{width:36px;height:36px;border-radius:9px;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;color:var(--text2);transition:all .2s}
.tb-icon:hover{border-color:var(--primary);color:var(--primary2)}
.fund-btn{display:flex;align-items:center;gap:7px;padding:8px 16px;border-radius:9px;background:var(--primary);color:#000;border:none;font-size:13px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s}
.fund-btn:hover{background:var(--primary2);transform:translateY(-1px);box-shadow:0 4px 16px var(--primary-glow)}
.page{padding:20px 24px}
/* SEASONAL */
.seasonal{border-radius:14px;padding:13px 18px;display:flex;align-items:center;gap:13px;margin-bottom:18px;position:relative;overflow:hidden;cursor:pointer}
.seasonal.christmas{background:linear-gradient(135deg,#0d3b22,#0a4a1c);border:1px solid #1a6b35}
.seasonal.promo{background:linear-gradient(135deg,#2d1a00,#3d2200);border:1px solid #8a5500}
.seasonal.info{background:linear-gradient(135deg,#0a1f40,#0d2a55);border:1px solid #1e4080}
.seasonal.newyear{background:linear-gradient(135deg,#1a1040,#0d0d2b);border:1px solid #3d2d80}
.sl-icon{width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.sl-title{font-size:14px;font-weight:700}
.sl-sub{font-size:12px;opacity:.8;margin-top:2px}
.sl-cta{background:var(--primary);color:#000;border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;flex-shrink:0}
.sl-close{background:none;border:none;color:rgba(255,255,255,.4);font-size:18px;cursor:pointer;margin-left:4px}
/* WALLET */
.wallet-row{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:14px;margin-bottom:20px}
.wc{background:linear-gradient(135deg,#1a1200 0%,#2a1c00 40%,#0e0b00 100%);border:1px solid #4a3000;border-radius:20px;padding:24px;position:relative;overflow:hidden}
.wc::before{content:'';position:absolute;top:-50px;right:-30px;width:200px;height:200px;background:radial-gradient(circle,rgba(245,166,35,.18),transparent 70%);pointer-events:none}
.wc-lbl{font-size:10px;color:#b8860b;letter-spacing:2px;text-transform:uppercase;margin-bottom:7px}
.wc-bal{font-size:36px;font-weight:800;letter-spacing:-1.5px;background:linear-gradient(90deg,#fff,#fcd34d);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.wc-meta{display:flex;gap:18px;padding-top:12px;border-top:1px solid rgba(245,166,35,.15);margin-top:12px}
.wc-s-lbl{font-size:10px;color:#8a6600;margin-bottom:3px}
.wc-s-val{font-size:14px;font-weight:700}
.wc-btns{display:flex;gap:8px;margin-top:14px}
.wc-btn{flex:1;padding:10px;border-radius:11px;font-size:12px;font-weight:700;cursor:pointer;border:none;font-family:'Outfit',sans-serif;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.wc-p{background:var(--primary);color:#000}
.wc-p:hover{background:var(--primary2)}
.wc-g{background:rgba(245,166,35,.12);color:var(--primary2);border:1px solid rgba(245,166,35,.2)}
.wc-g:hover{background:rgba(245,166,35,.2)}
/* VA */
.va{background:var(--card2);border:1px solid var(--border2);border-radius:12px;padding:12px 14px;margin-top:12px;display:flex;align-items:center;gap:10px}
.va-ic{width:36px;height:36px;border-radius:9px;background:var(--green-dim);display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--green);flex-shrink:0}
.va-lbl{font-size:10px;color:var(--text3)}
.va-num{font-size:15px;font-weight:800;letter-spacing:1px;color:var(--green)}
.va-copy{margin-left:auto;background:var(--green-dim);border:none;color:var(--green);width:32px;height:32px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:all .2s}
.va-copy:hover{background:rgba(34,211,165,.2)}
/* STAT CARDS */
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:18px}
.sc-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.sc-ic{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px}
.sc-val{font-size:24px;font-weight:800;letter-spacing:-1px}
.sc-lbl{font-size:11px;color:var(--text2);margin-top:4px}
.trend{font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px}
.t-up{background:var(--green-dim);color:var(--green)}.t-dn{background:var(--red-dim);color:var(--red)}
.sc-bar{height:3px;background:var(--border);border-radius:2px;margin-top:12px;overflow:hidden}
.sc-fill{height:100%;border-radius:2px}
/* SERVICES GRID */
.services-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:22px}
.svc{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px 10px 12px;text-align:center;cursor:pointer;transition:all .2s;text-decoration:none;display:block;position:relative;overflow:hidden}
.svc:hover{transform:translateY(-3px);border-color:var(--primary);box-shadow:0 8px 24px var(--primary-glow)}
.svc-ic{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 9px}
.svc-name{font-size:12px;font-weight:600;color:var(--text)}
.svc-sub{font-size:10px;color:var(--text2);margin-top:2px}
.svc-disc{position:absolute;top:6px;right:6px;background:var(--primary);color:#000;font-size:8px;font-weight:800;padding:2px 5px;border-radius:4px}
/* BOTTOM */
.bottom-grid{display:grid;grid-template-columns:1fr 300px;gap:18px}
/* TX */
.tx-panel{background:var(--card);border:1px solid var(--border);border-radius:16px}
.tx-head{padding:15px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.tx-head h3{font-size:14px;font-weight:700}
.tx-row{display:flex;align-items:center;gap:11px;padding:12px 18px;cursor:pointer;transition:background .15s;text-decoration:none;color:var(--text)}
.tx-row:hover{background:rgba(255,255,255,.02)}
.tx-row+.tx-row{border-top:1px solid rgba(255,255,255,.03)}
.tx-ic{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.tx-name{font-size:13px;font-weight:600}
.tx-meta{font-size:11px;color:var(--text3);margin-top:2px}
.tx-amt{font-size:14px;font-weight:700}
.tx-amt.dr{color:var(--red)}.tx-amt.cr{color:var(--green)}
.tx-st{font-size:10px;font-weight:600;margin-top:2px}
.st-ok{color:var(--green)}.st-fail{color:var(--red)}.st-pend{color:var(--primary)}
/* RIGHT */
.right-stack{display:flex;flex-direction:column;gap:14px}
/* TIER CARD */
.tier-card{background:linear-gradient(135deg,#1a1200,#2a1c00);border:1px solid #4a3000;border-radius:16px;padding:18px;position:relative;overflow:hidden}
.tier-card::after{content:'★';position:absolute;right:-8px;top:-10px;font-size:100px;color:rgba(245,166,35,.05);line-height:1;pointer-events:none}
.tier-lbl{font-size:10px;color:#b8860b;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px}
.tier-name{font-size:22px;font-weight:800;color:var(--primary);letter-spacing:-1px}
.tier-disc{font-size:28px;font-weight:800;color:var(--primary2);letter-spacing:-2px;margin-top:4px}
.tier-disc span{font-size:14px;font-weight:500;color:#8a7040}
.tier-prog{margin-top:12px}
.tp-row{display:flex;justify-content:space-between;font-size:11px;color:#8a7040;margin-bottom:5px}
.tp-bar{height:5px;background:rgba(255,255,255,.08);border-radius:3px;overflow:hidden}
.tp-fill{height:100%;background:linear-gradient(90deg,var(--primary),var(--primary2));border-radius:3px;transition:width 1.2s cubic-bezier(.4,0,.2,1)}
.tier-desc{font-size:11px;color:#8a7040;margin-top:8px}
.tier-upgrade{width:100%;margin-top:12px;padding:9px;border-radius:9px;background:rgba(245,166,35,.12);border:1px solid rgba(245,166,35,.2);color:var(--primary2);font-size:12px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;display:flex;align-items:center;justify-content:center;gap:6px}
/* API CARD */
.api-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:18px}
.api-card h4{font-size:14px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.api-key-box{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-family:monospace;font-size:11px;color:var(--text2);word-break:break-all;margin-bottom:10px;position:relative}
.api-copy-btn{width:100%;padding:9px;border-radius:9px;background:var(--blue-dim);border:1px solid rgba(56,178,248,.2);color:var(--blue);font-size:12px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .2s}
.api-copy-btn:hover{background:rgba(56,178,248,.15)}
/* MODAL */
.mo{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);z-index:1000;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .25s}
.mo.open{opacity:1;pointer-events:all}
.mo-box{background:var(--card);border:1px solid var(--border);border-radius:18px;width:100%;max-width:440px;transform:translateY(20px);transition:transform .25s;max-height:90vh;overflow-y:auto}
.mo.open .mo-box{transform:translateY(0)}
.mo-head{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.mo-head h3{font-size:15px;font-weight:700}
.mo-close{background:none;border:none;color:var(--text2);font-size:20px;cursor:pointer}
.mo-body{padding:20px}
.fg{margin-bottom:14px}
.fl{display:block;font-size:10px;font-weight:700;color:var(--text2);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase}
.fc{width:100%;background:var(--surface);border:1.5px solid var(--border);border-radius:9px;padding:10px 13px;font-size:13px;color:var(--text);font-family:'Outfit',sans-serif;outline:none;transition:border-color .2s}
.fc:focus{border-color:var(--primary)}
.net-pills{display:flex;gap:8px;flex-wrap:wrap}
.np{padding:7px 14px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid transparent;transition:all .2s}
.np.mtn{background:var(--primary-dim);color:var(--primary);border-color:rgba(245,166,35,.2)}
.np.mtn.active{background:var(--primary);color:#000}
.np.air{background:var(--red-dim);color:#f87171;border-color:rgba(248,113,113,.2)}
.np.air.active{background:#f87171;color:#fff}
.np.glo{background:var(--green-dim);color:var(--green);border-color:rgba(34,211,165,.2)}
.np.glo.active{background:var(--green);color:#000}
.np.nin{background:var(--blue-dim);color:var(--blue);border-color:rgba(56,178,248,.2)}
.np.nin.active{background:var(--blue);color:#fff}
.amt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:7px}
.ap{padding:8px;border-radius:9px;text-align:center;font-size:12px;font-weight:700;cursor:pointer;background:var(--surface);border:1.5px solid var(--border);color:var(--text2);transition:all .2s}
.ap:hover,.ap.active{background:var(--primary-dim);border-color:var(--primary);color:var(--primary2)}
.pin-row{display:flex;gap:9px;justify-content:center;margin:14px 0}
.pin-i{width:50px;height:54px;text-align:center;background:var(--surface);border:2px solid var(--border);border-radius:11px;font-size:22px;color:var(--text);font-family:'Outfit',sans-serif;font-weight:700;outline:none;transition:border-color .2s}
.pin-i:focus{border-color:var(--primary)}
.bal-row{display:flex;justify-content:space-between;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:10px 13px;margin-bottom:14px;font-size:13px}
.bal-val{font-weight:700;color:var(--green)}
.submit{width:100%;padding:13px;border-radius:11px;background:var(--primary);color:#000;border:none;font-size:14px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.submit:hover{background:var(--primary2)}
.submit:disabled{opacity:.5;cursor:not-allowed}
/* TOAST */
.tc{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px}
.toast{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:13px 16px;display:flex;align-items:center;gap:10px;min-width:280px;box-shadow:0 8px 32px rgba(0,0,0,.4);animation:tin .3s ease;border-left:4px solid}
.toast.success{border-left-color:var(--green)}.toast.error{border-left-color:var(--red)}.toast.info{border-left-color:var(--blue)}
.toast-msg{font-size:13px;flex:1}
.toast-x{background:none;border:none;color:var(--text3);cursor:pointer}
/* PWA */
.pwa{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px 18px;width:calc(100% - 32px);max-width:400px;box-shadow:0 10px 36px rgba(0,0,0,.5);z-index:500;display:none;gap:12px;align-items:center;animation:slideUp .4s ease}
.pwa.show{display:flex}
.pwa-ic{width:48px;height:48px;border-radius:13px;background:linear-gradient(135deg,var(--primary),#d97706);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pwa-ic i{color:#fff;font-size:22px}
.pwa-install{background:var(--primary);color:#000;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif}
.pwa-later{background:none;border:1px solid var(--border);color:var(--text2);border-radius:8px;padding:8px 12px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif}
.pwa-x{position:absolute;top:10px;right:10px;background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer}
/* BOTTOM NAV */
.bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);padding:8px 0 calc(8px + env(safe-area-inset-bottom));z-index:300;justify-content:space-around}
.bn{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;color:var(--text3);font-size:10px;font-weight:500;padding:3px 12px;border-radius:9px;transition:color .2s}
.bn.active{color:var(--primary2)}
.bn i{font-size:21px}
.bn-fab{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#d97706);display:flex;align-items:center;justify-content:center;color:#000;margin-top:-16px;box-shadow:0 4px 16px var(--primary-glow);cursor:pointer;border:3px solid var(--bg)}
.bn-fab i{font-size:22px}
@keyframes tin{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideUp{from{opacity:0;transform:translateX(-50%) translateY(20px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.anim{animation:fadeUp .5s ease both}
.a1{animation-delay:.07s}.a2{animation-delay:.14s}
@media(max-width:1000px){.services-grid{grid-template-columns:repeat(3,1fr)}.wallet-row{grid-template-columns:1fr}.bottom-grid{grid-template-columns:1fr}}
@media(max-width:768px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.sidebar-overlay.open{display:block}.main-wrap{margin-left:0}.topbar{padding:0 16px}.hamburger{display:block}.page{padding:16px;padding-bottom:86px}.bottom-nav{display:flex}.services-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sb-head">
    <div class="sb-brand">
      <div class="sb-mark"><i class="ri-store-2-line"></i></div>
      <div class="sb-name">Naira<span>Flow</span></div>
    </div>
    <div class="sb-user">
      <div class="sb-av"><%= user.fullName.split(' ').map(n=>n[0]).join('').toUpperCase().substr(0,2) %></div>
      <div>
        <div class="sb-username"><%= user.fullName.split(' ')[0] %></div>
        <span class="sb-tier"><%= (user.resellerTier||'bronze').toUpperCase() %> RESELLER</span>
      </div>
    </div>
  </div>
  <nav class="sb-nav">
    <span class="sb-lbl">Overview</span>
