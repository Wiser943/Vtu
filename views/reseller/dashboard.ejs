          <span class="trend t-up"><i class="ri-arrow-up-line"></i> Live</span>
        </div>
        <div class="sc-val" style="color:var(--green)"><%= typeof dailyCount !== 'undefined' ? dailyCount : '0' %></div>
        <div class="sc-lbl">Transactions — Today</div>
