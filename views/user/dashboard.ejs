<!-- TOAST CONTAINER -->
<div class="toast-container" id="toastContainer"></div>

<script>
// ── SIDEBAR ─────────────────────────────────────────────────
const ham=document.getElementById('ham'),sb=document.getElementById('sidebar'),ov=document.getElementById('sidebarOverlay');
ham.addEventListener('click',()=>{sb.classList.toggle('open');ov.classList.toggle('open')});
ov.addEventListener('click',()=>{sb.classList.remove('open');ov.classList.remove('open')});

// ── MODAL ────────────────────────────────────────────────────
function openModal(id){document.getElementById(id).classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}
document.querySelectorAll('.modal-overlay').forEach(m=>m.addEventListener('click',function(e){if(e.target===this)this.classList.remove('open')}));

// ── TOAST ────────────────────────────────────────────────────
function showToast(msg,type='info'){
  const c=document.getElementById('toastContainer');
  const icons={success:'ri-checkbox-circle-line',error:'ri-close-circle-line',info:'ri-information-line'};
  const t=document.createElement('div');t.className=`toast ${type}`;
  t.innerHTML=`<i class="${icons[type]}" style="font-size:19px;color:var(--${type==='success'?'green':type==='error'?'red':'blue'})"></i><span class="toast-msg">${msg}</span><button class="toast-close" onclick="this.closest('.toast').remove()"><i class="ri-close-line"></i></button>`;
  c.appendChild(t);
  setTimeout(()=>{t.style.cssText='opacity:0;transform:translateX(20px);transition:all .3s'},4000);
  setTimeout(()=>t.remove(),4300);
}

// ── WALLET COUNTER ───────────────────────────────────────────
const balEl=document.getElementById('walletBal');
const target=parseFloat(balEl.dataset.amount||0);
let cur=0,hidden=false;
const step=target/60;
const timer=setInterval(()=>{cur=Math.min(cur+step,target);balEl.textContent='₦'+Math.floor(cur).toLocaleString();if(cur>=target)clearInterval(timer)},14);

document.getElementById('balToggle').addEventListener('click',function(){
  hidden=!hidden;
  balEl.textContent=hidden?'₦•••••':'₦'+Math.floor(target).toLocaleString();
  document.getElementById('balIcon').className=hidden?'ri-eye-off-line':'ri-eye-line';
});

// ── COPY ─────────────────────────────────────────────────────
function copyText(text){navigator.clipboard.writeText(text);showToast('Copied to clipboard!','success')}

// ── FUND AMOUNT ──────────────────────────────────────────────
function setFundAmount(v){document.getElementById('fundAmount').value=v}
async function initiateFund(){
  const amount=parseFloat(document.getElementById('fundAmount').value);
  if(!amount||amount<500)return showToast('Minimum fund amount is ₦500','error');
  const btn=event.target;btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/user/wallet/fund',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount})});
    const d=await r.json();
    if(d.success&&d.checkoutUrl){window.location.href=d.checkoutUrl}
    else{showToast(d.message||'Failed to initialize payment','error')}
  }catch(e){showToast('Server error, try again','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-bank-card-line"></i> Pay with Card';
}

// ── NETWORK PILLS ────────────────────────────────────────────
document.querySelectorAll('.network-pills').forEach(container=>{
  container.querySelectorAll('.net-pill').forEach(pill=>{
    pill.addEventListener('click',function(){
      this.closest('.network-pills').querySelectorAll('.net-pill').forEach(p=>p.classList.remove('active'));
      this.classList.add('active');
    });
  });
});

// ── PIN NAVIGATION ───────────────────────────────────────────
document.querySelectorAll('.pin-in').forEach((inp,i,all)=>{
  inp.addEventListener('input',()=>{inp.classList.toggle('filled',!!inp.value);if(inp.value&&i<all.length-1)all[i+1].focus()});
  inp.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!inp.value&&i>0)all[i-1].focus()});
});

// ── GET PIN VALUE ────────────────────────────────────────────
function getPin(container){return [...container.querySelectorAll('.pin-in')].map(i=>i.value).join('')}

// ── SERVICE MODAL ROUTER ─────────────────────────────────────
function openServiceModal(type){openModal(type+'Modal')}

// ── AIRTIME SUBMIT ───────────────────────────────────────────
async function submitAirtime(){
  const network=document.querySelector('#airtimeNetworks .net-pill.active')?.dataset.net;
  const phone=document.getElementById('airtimePhone').value.trim();
  const amount=parseFloat(document.getElementById('airtimeAmount').value);
  const pin=getPin(document.querySelector('#airtimeModal .pin-grid'));
  if(!network)return showToast('Select a network','error');
  if(!phone||phone.length!==11)return showToast('Enter a valid 11-digit phone number','error');
  if(!amount||amount<50)return showToast('Minimum airtime amount is ₦50','error');
  if(pin.length!==4)return showToast('Enter your 4-digit PIN','error');
  const btn=document.getElementById('airtimeSubmitBtn');
  btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/user/airtime',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({network,phone,amount,pin})});
    const d=await r.json();
    if(d.success){showToast(d.message,'success');closeModal('airtimeModal');setTimeout(()=>location.reload(),2000)}
    else showToast(d.message||'Transaction failed','error');
  }catch(e){showToast('Server error, try again','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-phone-line"></i> Buy Airtime';
}

// ── DATA PRICE DISPLAY ───────────────────────────────────────
function updateDataPrice(){
  const sel=document.getElementById('dataPlan');
  const disp=document.getElementById('dataPriceDisplay');
  const val=document.getElementById('dataPriceVal');
  if(sel.value){
    const parts=sel.value.split('|');
    val.textContent='₦'+parseInt(parts[3]).toLocaleString();
    disp.style.display='flex';
  }else{disp.style.display='none'}
}

// ── DATA SUBMIT ──────────────────────────────────────────────
async function submitData(){
  const network=document.querySelector('#dataNetworks .net-pill.active')?.dataset.net;
  const phone=document.getElementById('dataPhone').value.trim();
  const planSel=document.getElementById('dataPlan').value;
  const pin=getPin(document.getElementById('dataPinGrid'));
  if(!phone||phone.length!==11)return showToast('Enter a valid phone number','error');
  if(!planSel)return showToast('Select a data plan','error');
  if(pin.length!==4)return showToast('Enter your 4-digit PIN','error');
  const parts=planSel.split('|');
  const [variationCode,,planName,amount]=parts;
  const btn=document.getElementById('dataSubmitBtn');
  btn.disabled=true;btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Processing...';
  try{
    const r=await fetch('/user/data',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({serviceId:network,variationCode,phone,pin,planName,amount})});
    const d=await r.json();
    if(d.success){showToast(d.message,'success');closeModal('dataModal');setTimeout(()=>location.reload(),2000)}
    else showToast(d.message||'Transaction failed','error');
  }catch(e){showToast('Server error, try again','error')}
  btn.disabled=false;btn.innerHTML='<i class="ri-signal-wifi-line"></i> Buy Data';
}

// ── MARK NOTIFS READ ─────────────────────────────────────────
async function markAllRead(){
  await fetch('/user/notifications/mark-read',{method:'POST'});
  document.querySelectorAll('[style*="width:8px"]').forEach(d=>d.remove());
  showToast('All notifications marked as read','success');
}

// ── FAV QUICK SEND ───────────────────────────────────────────
function quickSendToFav(phone,network,type){
  if(type==='airtime'){openModal('airtimeModal');setTimeout(()=>document.getElementById('airtimePhone').value=phone,100)}
  else{openModal('dataModal');setTimeout(()=>document.getElementById('dataPhone').value=phone,100)}
}

// ── TX FILTER ────────────────────────────────────────────────
document.querySelectorAll('.tf').forEach(btn=>{
  btn.addEventListener('click',function(){
    document.querySelectorAll('.tf').forEach(b=>b.classList.remove('active'));
    this.classList.add('active');
    const filter=this.dataset.filter;
    document.querySelectorAll('.tx-item').forEach(row=>{
      if(filter==='all'||['cable','electricity','exam'].includes(row.dataset.type)&&filter==='bills')row.style.display='flex';
      else if(row.dataset.type===filter)row.style.display='flex';
      else row.style.display='none';
    });
  });
});

// ── PWA ──────────────────────────────────────────────────────
let deferredPrompt;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault();deferredPrompt=e;
  if(!localStorage.getItem('pwaDismissed'))setTimeout(()=>document.getElementById('pwaBanner').classList.add('show'),4000);
});
document.getElementById('pwaInstallBtn')?.addEventListener('click',async()=>{
  if(!deferredPrompt)return;
  deferredPrompt.prompt();
  const{outcome}=await deferredPrompt.userChoice;
  if(outcome==='accepted')showToast('NairaFlow app installed!','success');
  deferredPrompt=null;document.getElementById('pwaBanner').classList.remove('show');
});
function dismissPwa(){document.getElementById('pwaBanner').classList.remove('show');localStorage.setItem('pwaDismissed','1')}

// ── SERVICE WORKER ───────────────────────────────────────────
if('serviceWorker' in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));

@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
</script>
<style>@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}</style>
</body>
</html>
