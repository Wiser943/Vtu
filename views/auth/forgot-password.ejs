<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reset Password — NairaFlow</title>
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#07101c;--card:#0f1e2e;--border:#1b3048;--primary:#5b6af0;--primary2:#818cf8;--green:#22d3a5;--red:#f05f6e;--text:#ddeeff;--text2:#6a92b8;--text3:#2d4a65}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Outfit',sans-serif;background:var(--bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
body::before{content:'';position:absolute;top:-200px;left:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(91,106,240,.1),transparent 70%);pointer-events:none}
.wrap{width:100%;max-width:400px;position:relative;z-index:1}
.logo{text-align:center;margin-bottom:28px}
.logo-icon{width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--primary),#7c3aed);display:flex;align-items:center;justify-content:center;margin:0 auto 10px}
.logo-icon i{color:#fff;font-size:24px}
.logo-name{font-size:22px;font-weight:800;letter-spacing:-.5px}
.logo-name span{color:var(--primary2)}
.card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:28px}
.card-title{font-size:18px;font-weight:700;margin-bottom:6px}
.card-sub{font-size:13px;color:var(--text2);margin-bottom:22px}
.alert-success{background:rgba(34,211,165,.08);border:1px solid rgba(34,211,165,.2);border-radius:10px;padding:14px;font-size:13px;color:var(--green);display:flex;align-items:flex-start;gap:10px;margin-bottom:16px}
.fg{margin-bottom:16px}
.fl{display:block;font-size:11px;font-weight:700;color:var(--text2);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase}
.iw{position:relative}
.ii{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:15px;pointer-events:none}
.fc{width:100%;background:#0a1828;border:1.5px solid var(--border);border-radius:10px;padding:11px 13px 11px 38px;font-size:14px;color:var(--text);font-family:'Outfit',sans-serif;outline:none;transition:border-color .2s}
.fc:focus{border-color:var(--primary)}
.fc::placeholder{color:var(--text3)}
.btn{width:100%;padding:13px;border-radius:11px;background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff;border:none;font-size:14px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s}
.btn:hover{opacity:.9}
.back{text-align:center;font-size:13px;color:var(--text2);margin-top:18px}
.back a{color:var(--primary2);text-decoration:none;font-weight:600}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">
    <div class="logo-icon"><i class="ri-flashlight-fill"></i></div>
    <div class="logo-name">Naira<span>Flow</span></div>
  </div>
  <div class="card">
    <div class="card-title">Forgot Password?</div>
    <div class="card-sub">Enter your email and we'll send a reset link</div>

    <% if(typeof success !== 'undefined' && success) { %>
    <div class="alert-success"><i class="ri-checkbox-circle-line" style="font-size:18px;flex-shrink:0"></i><div><strong>Check your email!</strong><br>We've sent a password reset link to your email address. Check your inbox and spam folder.</div></div>
    <% } else { %>
    <form method="POST" action="/auth/forgot-password" id="fpForm">
      <div class="fg">
        <label class="fl">Email Address</label>
        <div class="iw"><i class="ri-mail-line ii"></i><input type="email" name="email" class="fc" placeholder="your@email.com" required></div>
      </div>
      <button type="submit" class="btn" id="fpBtn"><i class="ri-send-plane-line"></i> Send Reset Link</button>
    </form>
    <% } %>
    <div class="back"><a href="/auth/login"><i class="ri-arrow-left-line"></i> Back to Login</a></div>
  </div>
</div>
<script>
document.getElementById('fpForm')?.addEventListener('submit',function(){
  const btn=document.getElementById('fpBtn');btn.disabled=true;
  btn.innerHTML='<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Sending...';
});
</script>
</body>
</html>
