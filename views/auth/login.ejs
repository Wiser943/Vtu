<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Login — NairaFlow</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="manifest" href="/manifest.json">
  <style>
    :root{--bg:#07101c;--card:#0f1e2e;--border:#1b3048;--primary:#5b6af0;--primary2:#818cf8;--green:#22d3a5;--red:#f05f6e;--text:#ddeeff;--text2:#6a92b8;--text3:#2d4a65}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Outfit',sans-serif;background:var(--bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;position:relative;overflow:hidden}
    body::before{content:'';position:absolute;top:-200px;left:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(91,106,240,.12),transparent 70%);pointer-events:none}
    body::after{content:'';position:absolute;bottom:-150px;right:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(34,211,165,.06),transparent 70%);pointer-events:none}
    .wrap{width:100%;max-width:420px;position:relative;z-index:1}
    .logo-area{text-align:center;margin-bottom:32px}
    .logo-icon{width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,var(--primary),#7c3aed);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;box-shadow:0 8px 24px rgba(91,106,240,.35)}
    .logo-icon i{color:#fff;font-size:26px}
    .logo-name{font-size:26px;font-weight:800;letter-spacing:-.5px;color:var(--text)}
    .logo-name span{color:var(--primary2)}
    .logo-sub{font-size:13px;color:var(--text2);margin-top:4px}
    .card{background:var(--card);border:1px solid var(--border);border-radius:22px;padding:32px}
    .card-title{font-size:20px;font-weight:700;margin-bottom:6px}
    .card-sub{font-size:13px;color:var(--text2);margin-bottom:26px}
    .alert{padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:16px;display:flex;align-items:center;gap:10px}
    .alert-error{background:rgba(240,95,110,.1);border:1px solid rgba(240,95,110,.2);color:#f87a8a}
    .alert-success{background:rgba(34,211,165,.08);border:1px solid rgba(34,211,165,.2);color:var(--green)}
    .form-group{margin-bottom:18px;position:relative}
    .form-label{display:block;font-size:11px;font-weight:700;color:var(--text2);margin-bottom:7px;letter-spacing:.5px;text-transform:uppercase}
    .input-wrap{position:relative}
    .input-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:16px;pointer-events:none}
    .form-ctrl{width:100%;background:#0a1828;border:1.5px solid var(--border);border-radius:11px;padding:12px 14px 12px 40px;font-size:14px;color:var(--text);font-family:'Outfit',sans-serif;outline:none;transition:border-color .2s}
    .form-ctrl:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(91,106,240,.12)}
    .form-ctrl::placeholder{color:var(--text3)}
    .pw-toggle{position:absolute;right:13px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text3);cursor:pointer;font-size:17px;padding:4px}
    .pw-toggle:hover{color:var(--text2)}
    .forgot{font-size:12px;color:var(--primary2);text-decoration:none;float:right;margin-top:-14px;margin-bottom:18px;display:block;text-align:right}
    .forgot:hover{color:#fff}
    .submit-btn{width:100%;padding:14px;border-radius:12px;background:linear-gradient(135deg,var(--primary),#7c3aed);color:#fff;border:none;font-size:15px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:6px}
    .submit-btn:hover{opacity:.9;transform:translateY(-1px);box-shadow:0 6px 24px rgba(91,106,240,.4)}
    .submit-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
    .divider{text-align:center;color:var(--text3);font-size:12px;margin:20px 0;position:relative}
    .divider::before,.divider::after{content:'';position:absolute;top:50%;width:40%;height:1px;background:var(--border)}
    .divider::before{left:0}.divider::after{right:0}
    .signup-link{text-align:center;font-size:13px;color:var(--text2);margin-top:20px}
    .signup-link a{color:var(--primary2);text-decoration:none;font-weight:600}
    .signup-link a:hover{color:#fff}
    .security-note{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text3);margin-top:20px;text-align:center;justify-content:center}
    @keyframes fadeIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .wrap{animation:fadeIn .5s ease}
    @keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
  </style>
</head>
<body>
<div class="wrap">
  <div class="logo-area">
    <div class="logo-icon"><i class="ri-flashlight-fill"></i></div>
    <div class="logo-name">Naira<span>Flow</span></div>
    <div class="logo-sub">Nigeria's fastest VTU platform</div>
  </div>

  <div class="card">
    <div class="card-title">Welcome back</div>
    <div class="card-sub">Sign in to your account</div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><i class="ri-error-warning-line"></i> <%= error %></div>
    <% } %>
    <% if (locals.success && success.length > 0) { %>
    <div class="alert alert-success"><i class="ri-checkbox-circle-line"></i> <%= success[0] %></div>
    <% } %>

    <form method="POST" action="/auth/login" id="loginForm">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <div class="input-wrap">
          <i class="ri-mail-line input-icon"></i>
          <input type="email" name="email" class="form-ctrl" placeholder="your@email.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required autocomplete="email">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Password</label>
        <div class="input-wrap">
          <i class="ri-lock-line input-icon"></i>
          <input type="password" name="password" class="form-ctrl" id="pwField" placeholder="Enter your password" required autocomplete="current-password">
          <button type="button" class="pw-toggle" onclick="togglePw('pwField','pwIcon')"><i class="ri-eye-off-line" id="pwIcon"></i></button>
        </div>
      </div>

      <a href="/auth/forgot-password" class="forgot">Forgot password?</a>

      <button type="submit" class="submit-btn" id="loginBtn">
        <i class="ri-login-box-line"></i> Sign In
      </button>
    </form>

    <div class="signup-link">
      Don't have an account? <a href="/auth/register">Create one free</a>
    </div>
    <div class="security-note">
      <i class="ri-shield-check-line"></i> Secured with 256-bit SSL encryption
    </div>
  </div>
</div>

<script>
function togglePw(fieldId, iconId) {
  const f = document.getElementById(fieldId);
  const i = document.getElementById(iconId);
  if (f.type === 'password') { f.type = 'text'; i.className = 'ri-eye-line'; }
  else { f.type = 'password'; i.className = 'ri-eye-off-line'; }
}
document.getElementById('loginForm').addEventListener('submit', function() {
  const btn = document.getElementById('loginBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="ri-loader-4-line" style="animation:spin 1s linear infinite"></i> Signing in...';
});
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
</script>
</body>
</html>
